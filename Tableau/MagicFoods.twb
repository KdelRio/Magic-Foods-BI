e='measure' type='quantitative' default-format="p0.0%"><calculation class='tableau' formula="SUM([VentaReal])/SUM([MetaVenta])" /></column><column caption="Meta" datatype='real' name='[Meta]' role='measure' type='quantitative' default-format='n"$"#,##0" mill."'><calculation class='tableau' formula="(SUM([MetaVenta])) / 1000000" /></column><column caption="Var Interanual %" datatype='real' name='[VarYoY]' role='measure' type='quantitative' default-format="p+0.0%;-0.0%"><calculation class='tableau' formula='(SUM(IF YEAR([Fecha])=(IF [Parameters].[pAnio]="Todos" THEN 2024 ELSE INT([Parameters].[pAnio]) END) THEN [VentaReal] END) - SUM(IF YEAR([Fecha])=(IF [Parameters].[pAnio]="Todos" THEN 2024 ELSE INT([Parameters].[pAnio]) END)-1 THEN [VentaReal] END)) / SUM(IF YEAR([Fecha])=(IF [Parameters].[pAnio]="Todos" THEN 2024 ELSE INT([Parameters].[pAnio]) END)-1 THEN [VentaReal] END)' /></column><column datatype='string' name='[Vendedor]' role='dimension' type='nominal' caption="Vendedor" /><column caption="Ventas Netas" datatype='real' name='[VentaM]' role='measure' type='quantitative' default-format='n"$"#,##0" mill."'><calculation class='tableau' formula="(SUM([VentaReal])) / 1000000" /></column><column caption="Filtro Canal" datatype='boolean' name='[fCanal]' role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[pCanal]="Todos" OR [Canal]=[Parameters].[pCanal]' /></column><column caption="Filtro mes" datatype='boolean' name='[fMes]' role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[pMes]="Todos" OR STR(MONTH([Fecha]))=[Parameters].[pMes]' /></column><column-instance column='[Canal]' derivation='None' name='[none:Canal:nk]' pivot='key' type='nominal' /><column-instance column='[Vendedor]' derivation='None' name='[none:Vendedor:nk]' pivot='key' type='nominal' /><column-instance column='[fCanal]' derivation='None' name='[none:fCanal:nk]' pivot='key' type='nominal' /><column-instance column='[fMes]' derivation='N