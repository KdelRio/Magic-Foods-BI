{
  "name": "MagicFoods",
  "dataColors": [
    "#1F4E78",
    "#2E86AB",
    "#F18F01",
    "#6BAA75",
    "#C73E1D",
    "#8E6C8A",
    "#3B9C9C",
    "#E4B363",
    "#5C7AEA",
    "#A23B72"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1F4E78",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E5EA"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F4E78"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F4E78"
              }
            },
            "fontSize": 22
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}