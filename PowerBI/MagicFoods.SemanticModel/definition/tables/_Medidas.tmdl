	measure 'Saldo CxC' = SUM(CuentasPorCobrar[SaldoPendiente])
		formatString: \$#,0
		displayFolder: Cuentas por Cobrar y Pagar
		lineageTag: b514ce2d-1106-57d1-a141-1203cc844348

	measure 'Saldo Vencido CxC' = CALCULATE(SUM(CuentasPorCobrar[SaldoPendiente]), CuentasPorCobrar[Estado] = "Vencida")
		formatString: \$#,0
		displayFolder: Cuentas por Cobrar y Pagar
		lineageTag: e1f13f90-e1ea-5e41-9b90-3861bf37b2b7

	measure 'Facturas en Gestión' = CALCULATE(COUNTROWS(CuentasPorCobrar), CuentasPorCobrar[GestionCobranza] = "En gestión de cobranza")
