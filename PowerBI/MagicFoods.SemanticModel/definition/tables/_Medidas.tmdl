table _Medidas
	lineageTag: ed054d2c-21a5-5202-be5b-1d04aac1c92e

	measure 'Ventas Netas' = CALCULATE(SUM(DetallePedidos[VentaNeta]), DetallePedidos[EstadoPedido] <> "Anulado")
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: b2b6bf9b-2e48-54a3-82d6-46e40beac9f0

	measure 'Costo de Ventas' = CALCULATE(SUM(DetallePedidos[CostoTotal]), DetallePedidos[EstadoPedido] <> "Anulado")
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: 7da3e1fc-ec2d-5a3b-a568-570cd34a5f1f

	measure 'Margen Bruto' = [Ventas Netas] - [Costo de Ventas]
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: fd4c16f2-2f86-5284-a976-03fb2fd95aaa

	measure 'Margen Bruto %' = DIVIDE([Margen Bruto], [Ventas Netas])
		formatString: 0.0%
		displayFolder: Comercial
		lineageTag: deb83875-856d-5dc4-97c0-14185899263a

	measure 'Pedidos' = CALCULATE(DISTINCTCOUNT(DetallePedidos[PedidoID]), DetallePedidos[EstadoPedido] <> "Anulado")
		formatString: #,0
		displayFolder: Comercial
		lineageTag: 56819ac7-40d5-5d0b-9503-e911acedd09a

	measure 'Unidades Vendidas' = CALCULATE(SUM(DetallePedidos[Cantidad]), DetallePedidos[EstadoPedido] <> "Anulado")
		formatString: #,0
		displayFolder: Comercial
		lineageTag: dc852921-16a1-5e23-af2a-e844052b20a4

	measure 'Ticket Promedio' = DIVIDE([Ventas Netas], [Pedidos])
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: ebe6acfa-9e23-55f8-b326-71654e09fc3f

	measure 'Ventas Año Anterior' = CALCULATE([Ventas Netas], SAMEPERIODLASTYEAR(Calendario[Fecha]))
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: d9127e29-8d7d-53d3-8020-16bece1ba00c

	measure 'Var Interanual %' = VAR y = MAX(Calendario[Anio]) VAR act = CALCULATE([Ventas Netas], Calendario[Anio] = y) VAR ant = CALCULATE([Ventas Netas], Calendario[Anio] = y - 1) RETURN DIVIDE(act - ant, ant)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comercial
		lineageTag: 93d6a029-b8b9-52bc-a579-72ba7621246e

	measure 'Pedidos Pendientes' = CALCULATE(COUNTROWS(Pedidos), Pedidos[Estado] = "Pendiente de entrega")
		formatString: #,0
		displayFolder: Comercial
		lineageTag: 5ca0e1c3-ec92-5fa4-975d-9407742c8c92

	measure 'Monto por Facturar' = CALCULATE(SUM(Pedidos[MontoNeto]), Pedidos[Estado] = "Entregado - Por facturar")
		formatString: \$#,0
		displayFolder: Comercial
		lineageTag: 43352155-2a54-56e4-8786-fca46fff81a1

	measure 'Entregas a Tiempo %' = DIVIDE(CALCULATE(COUNTROWS(Pedidos), Pedidos[EntregaATiempo] = "Sí"), CALCULATE(COUNTROWS(Pedidos), Pedidos[EntregaATiempo] <> BLANK()))
		formatString: 0.0%
		displayFolder: Comercial
		lineageTag: b1d90999-dbc3-5dff-8e24-af07658d6053

	measure 'Meta' = SUM(Metas[MetaVenta])
		formatString: \$#,0
		displayFolder: Metas y Comisiones
		lineageTag: c76190dc-aa6a-509e-80af-fcf084d8a07e

	measure 'Logro Meta %' = DIVIDE([Ventas Netas], [Meta])
		formatString: 0.0%
		displayFolder: Metas y Comisiones
		lineageTag: b5333371-c22a-5356-9fe3-6dd4abfcb8c6

	measure 'Comisión' = SUMX(SUMMARIZE(Metas, Vendedores[VendedorID], Calendario[AnioMes]), VAR v = [Ventas Netas] VAR l = DIVIDE(v, [Meta]) RETURN v * SWITCH(TRUE(), l >= 1.1, 0.045, l >= 1, 0.035, l >= 0.95, 0.025, l >= 0.8, 0.015, 0))
		formatString: \$#,0
		displayFolder: Metas y Comisiones
		lineageTag: 89d5441b-9362-5354-8eb0-a8947aff9c82

	measure 'Ingresos' = SUM(EstadoResultados[Ingresos])
		formatString: \$#,0
		displayFolder: Finanzas
		lineageTag: a478c159-32ed-583e-b85d-abcd94f3563e

	measure 'EBITDA' = SUM(EstadoResultados[EBITDA])
		formatString: \$#,0
		displayFolder: Finanzas
		lineageTag: 682209b9-daf7-54c1-a020-aef9ae9bb9e2

	measure 'Utilidad Neta' = SUM(EstadoResultados[UtilidadNeta])
