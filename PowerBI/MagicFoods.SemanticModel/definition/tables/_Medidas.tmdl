	measure 'Valor Inventario' = VAR f = MAX(StockMensual[FechaCierre]) RETURN CALCULATE(SUM(StockMensual[ValorInventario]), StockMensual[FechaCierre] = f)
		formatString: \$#,0
		displayFolder: Inventario
