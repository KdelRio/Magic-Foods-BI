	measure 'Insumos en Stock Crítico' = VAR f = MAX(StockMensual[FechaCierre]) RETURN CALCULATE(COUNTROWS(StockMensual), StockMensual[FechaCierre] = f, StockMensual[Alerta] = "Crítico") + 0
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 882a368d-51d0-5764-b85d-8f7b87dd1c82

	measure 'Alertas Stock Crítico' = CALCULATE(COUNTROWS(StockMensual), StockMensual[Alerta] = "Crítico") + 0
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 71d0fa63-551f-55a7-b708-cef2bcf05827

	measure 'Dotación' = DISTINCTCOUNT(Marcaciones[EmpleadoID])
		formatString: #,0
		displayFolder: Personas
		lineageTag: 5c702aee-f009-590a-9697-95f77d20c51c

	measure 'Registros Asistencia' = COUNTROWS(Marcaciones)
		formatString: #,0
		displayFolder: Personas
		lineageTag: ebe2f524-52df-5f01-861f-26a0ec22c59f

	measure 'Tasa Ausentismo' = DIVIDE(CALCULATE(COUNTROWS(Marcaciones), Marcaciones[Estado] IN {"Ausente", "Licencia médica"}), CALCULATE(COUNTROWS(Marcaciones), Marcaciones[Estado] <> "Vacaciones"))
		formatString: 0.0%
		displayFolder: Personas
		lineageTag: 54a28908-cdde-58ee-ab99-6b013b45cc9f

	measure 'Puntualidad %' = 1 - DIVIDE(CALCULATE(COUNTROWS(Marcaciones), Marcaciones[MinutosAtraso] > 5), CALCULATE(COUNTROWS(Marcaciones), Marcaciones[Estado] = "Presente"))
		formatString: 0.0%
		displayFolder: Personas
		lineageTag: 2a708c4f-d74f-5d16-a974-fb24bf1242ed

	measure 'Horas Extra' = SUM(Marcaciones[HorasExtra])
