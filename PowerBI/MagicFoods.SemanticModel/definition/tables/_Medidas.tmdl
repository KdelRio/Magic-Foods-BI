		lineageTag: afbb8e3c-b532-5110-8bb5-a929441740af

	measure 'ROE' = AVERAGE(Indicadores[ROE])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: 1d7c241a-e01b-5108-b37a-d9c51681896f

	measure 'ROA' = AVERAGE(Indicadores[ROA])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: fa88224c-8736-5258-bf1c-ceecea5490d1

	measure 'ROI' = AVERAGE(Indicadores[ROI])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: 4470f999-ac77-5f5a-8f67-7961c944746e

	measure 'ROCE' = AVERAGE(Indicadores[ROCE])
