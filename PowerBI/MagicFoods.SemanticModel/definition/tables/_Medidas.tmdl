	measure 'Test Ácido' = VAR f = MAX(Indicadores[Fecha]) RETURN CALCULATE(SUM(Indicadores[TestAcido]), Indicadores[Fecha] = f)
		formatString: 0.00
		displayFolder: Finanzas
		lineageTag: 53068122-778a-55c1-8775-785929ef9487

	measure 'Capital Circulante' = VAR f = MAX(Indicadores[Fecha]) RETURN CALCULATE(SUM(Indicadores[CapitalCirculante]), Indicadores[Fecha] = f)
