	measure 'Margen Bruto Contable %' = DIVIDE(SUM(EstadoResultados[UtilidadBruta]), [Ingresos])
		formatString: 0.0%
		displayFolder: Finanzas
		lineageTag: dcba6d4c-e698-537b-860a-b2103b8b78d6

	measure 'Margen EBITDA %' = DIVIDE([EBITDA], [Ingresos])
