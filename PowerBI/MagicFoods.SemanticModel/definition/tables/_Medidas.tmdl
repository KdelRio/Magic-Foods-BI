	measure 'Reclamos' = COUNTROWS(Reclamos)
		formatString: #,0
		displayFolder: Calidad
		lineageTag: b377b623-caed-5425-ac3b-78e7101cfdf7

	measure 'Días Resolución Promedio' = AVERAGE(Reclamos[DiasResolucion])
		formatString: 0.0
		displayFolder: Calidad
		lineageTag: bff41510-86cc-51c2-84dc-25819a0fb08c

	measure 'Registro Completo %' = DIVIDE(CALCULATE(COUNTROWS(Reclamos), Reclamos[RegistroCompleto] = "Sí"), [Reclamos])
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 7ab4d59b-2dc0-5b0f-a1a8-7ac9b5a6cbd0

	measure 'Reclamos Abiertos' = CALCULATE(COUNTROWS(Reclamos), Reclamos[Estado] = "En proceso") + 0
